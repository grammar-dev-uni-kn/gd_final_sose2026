"VERBS"

agapao  V * @MOOD-IND
            @PRESENT
            @ASPECT-IMPERF
            @VOICE-ACT
            @(AGR 1 sg)
            @(TRANS love).

agapai  V * @MOOD-IND
             @PRESENT
             @ASPECT-IMPERF
             @VOICE-ACT
             @(AGR 3 sg)
             @(TRANS love).

anakinosate  V * @MOOD-IND
                 @PAST
                 @ASPECT-PERF
                 @VOICE-ACT
                 @(AGR 2 pl)
                 { @(DITRANS announce)
                 | @(GEN-COMP announce) }.

edosa V* @MOOD-IND
         @PAST
         @ASPECT-PERF
         @VOICE-ACT
         @(AGR 1 sg)
         @(DITRANS give).

ehi  V * @MOOD-IND
         @PRESENT
         @ASPECT-IMPERF
         @VOICE-ACT
         @(AGR 3 sg)
         @(TRANS have).

ekatsa V* @MOOD-IND
          @PAST
          @ASPECT-PERF
          @VOICE-ACT
          @(AGR 1 sg)
          @(INTRANS sit).

enimerosan V* @MOOD-IND
              @PAST
              @ASPECT-PERF
              @VOICE-ACT
              @(AGR 3 pl)
              @(OBJ-COMP inform).

etroyes V* @MOOD-IND
           @PAST
           @ASPECT-PERF
           @VOICE-ACT
           @(AGR 2 sg)
           @(OPT-TRANS eat).

ftanun V* @MOOD-IND
           @PRESENT
           @ASPECT-IMPERF
           @VOICE-ACT
           @(AGR 3 pl)
           @(INTRANS arrive).

grafis  V* @MOOD-IND
           @PRESENT
           @ASPECT-IMPERF
           @VOICE-ACT
           @(AGR 2 sg)
           @(OPT-TRANS write).

ida    V * @MOOD-IND
           @PAST
           @ASPECT-PERF
           @VOICE-ACT
           @(AGR 1 sg)
           { @(TRANS see)
           | @(COMP-ONLY see) }.

ipa    V * @MOOD-IND
            @PAST
            @ASPECT-PERF
            @VOICE-ACT
            @(AGR 1 sg)
            { @(TRANS tell)
            | @(DITRANS tell)
            | @(GEN-COMP tell)
            | @(COMP-ONLY tell) }.

ipan    V * @MOOD-IND
            @PAST
            @ASPECT-PERF
            @VOICE-ACT
            @(AGR 3 pl)
            { @(TRANS tell)
            | @(DITRANS tell)
            | @(GEN-COMP tell)
            | @(COMP-ONLY tell) }.

ipe    V * @MOOD-IND
            @PAST
            @ASPECT-PERF
            @VOICE-ACT
            @(AGR 3 sg)
            { @(TRANS tell)
            | @(DITRANS tell)
            | @(GEN-COMP tell)
            | @(COMP-ONLY tell) }.

ipenthimizo  V * @MOOD-IND
                 @PRESENT
                 @ASPECT-IMPERF
                 @VOICE-ACT
                 @(AGR 1 sg)
                 { @(DITRANS remind)
                 | @(GEN-COMP remind) }.

kitao V* @MOOD-IND
          @PRESENT
          @ASPECT-IMPERF
          @VOICE-ACT
          @(AGR 1 sg)
          @(OPT-TRANS look). 

kitakse V* @MOOD-IND
            @PAST
            @ASPECT-PERF
            @VOICE-ACT
            @(AGR 3 sg)
            @(OPT-TRANS look).

metakomizun V* @MOOD-IND
                @PRESENT
                @ASPECT-IMPERF
                @VOICE-ACT
                @(AGR 3 pl)
                @(GOAL move).

metakomizete V* @MOOD-IND
                @PRESENT
                @ASPECT-IMPERF
                @VOICE-ACT
                @(AGR 2 pl)
                @(GOAL move).

pigame V* @MOOD-IND
         @PAST
         @ASPECT-PERF
         @VOICE-ACT
         @(AGR 1 pl)
         @(GOAL go).

pigan V* @MOOD-IND
         @PAST
         @ASPECT-PERF
         @VOICE-ACT
         @(AGR 3 pl)
         @(GOAL go).

taksidevun V* @MOOD-IND
               @PRESENT
               @ASPECT-IMPERF
               @VOICE-ACT
               @(AGR 3 pl)
               @(INTRANS travel).

zitane V* @MOOD-IND
          @PRESENT
          @ASPECT-IMPERF
          @VOICE-ACT
          @(AGR 3 pl)
          @(TRANS travel).


"ADJECTIVES"

diskolo A* (^ PRED) = 'difficult'
          { @(ADJ-AGR masc sg acc)
          | @(ADJ-AGR neut sg nom)
          | @(ADJ-AGR neut sg acc)
          | @(ADJ-AGR neut sg voc)}.

gliko  A* (^ PRED) = 'sweet'
          { @(ADJ-AGR masc sg acc)
          | @(ADJ-AGR neut sg nom)
          | @(ADJ-AGR neut sg acc)
          | @(ADJ-AGR neut sg voc)}.

kseni A* (^ PRED) = 'foreign'
          { @(ADJ-AGR masc pl nom)
          | @(ADJ-AGR masc sg voc)}.

ksenus A* (^ PRED) = 'foreign'
           @(ADJ-AGR masc pl acc).


ksenon A* (^ PRED) = 'foreign'
           @(ADJ-AGR masc pl gen).

omorfo A* (^ PRED) = 'beautiful'
          { @(ADJ-AGR masc sg acc)
          | @(ADJ-AGR neut sg nom)
          | @(ADJ-AGR neut sg acc)
          | @(ADJ-AGR neut sg voc)}.

omorfi A* (^ PRED) = 'beautiful'
          { @(ADJ-AGR fem sg nom)
          | @(ADJ-AGR fem sg acc)
          | @(ADJ-AGR fem sg voc)}.



"ADVERBS"

arga   ADV * (^ PRED) = 'late'.

avrio   ADV * (^ PRED) = 'tomorrow'.

poli   ADV * (^ PRED) = 'very'.

simera ADV * (^ PRED) = 'today'.

sidoma ADV * (^ PRED) = 'soon'.


"PRONOUNS"

mu  PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            @(PRON-AGR 1 sg gen).

me   PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            @(PRON-AGR 1 sg acc).

mas   PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            { @(PRON-AGR 1 pl gen)
            | @(PRON-AGR 1 pl acc) }.

su  PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            @(PRON-AGR 2 sg gen).

se   PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            @(PRON-AGR 2 sg acc).

sas   PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            { @(PRON-AGR 2 pl gen)
            | @(PRON-AGR 2 pl acc) }.

tu  PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            { (^ GEND) = masc
            | (^ GEND) = neut }
            @(PRON-AGR 3 sg gen).

ton    PRON * (^ PRED) = 'pro'
              (^ PRON-TYPE) = clitic
              (^ GEND) = masc
              @(PRON-AGR 3 sg acc).

tus   PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            (^ GEND) = masc
            { @(PRON-AGR 3 pl gen)
            | @(PRON-AGR 3 pl acc) }.

ths  PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            (^ GEND) = fem
            @(PRON-AGR 3 sg gen).
"this clitic is also pronounced [tis]. The reason I didn't put it with the previous one is that in greek even though they are pronounced exactly the same, they are written differently (της: sg gen / τις: pl gen & acc) - we have a lot of graphemes that represent the sound [i]. My main problem was that if I kept them under the same entry, the sentence no.7, would give me 2 solutions, one with the clitic being in sg and one in pl."

tis  PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            (^ GEND) = fem
            { @(PRON-AGR 3 pl gen)
            | @(PRON-AGR 3 pl acc) }.

tin    PRON * (^ PRED) = 'pro'
              (^ PRON-TYPE) = clitic
              (^ GEND) = fem
              @(PRON-AGR 3 sg acc).

to    PRON * (^ PRED) = 'pro'
             (^ PRON-TYPE) = clitic
             (^ GEND) = neut
             @(PRON-AGR 3 sg acc).

ta  PRON * (^ PRED) = 'pro'
            (^ PRON-TYPE) = clitic
            (^ GEND) = neut
            { @(PRON-AGR 3 pl gen)
            | @(PRON-AGR 3 pl acc) }.


"DETERMINERS - Definite/Indefinite"


o    D * (^ DEF) = +
         @DET-MASC-SG-NOM.

oi    D * (^ DEF) = +
          { @DET-MASC-PL-NOM
          | @DET-FEM-PL-NOM }.

"tu    D * (^ DEF) = +
          { @DET-MASC-SG-GEN
          | @DET-NEUT-SG-GEN }.

ton    D * (^ DEF) = +
           { @DET-MASC-SG-ACC
           | @DET-MASC-PL-GEN
           | @DET-FEM-PL-GEN
           | @DET-NEUT-PL-GEN }.

tus    D * (^ DEF) = +
            @DET-MASC-PL-ACC."

i    D * (^ DEF) = +
         @DET-FEM-SG-NOM.

"tis    D * (^ DEF) = +
           { @DET-FEM-SG-GEN
           | @DET-FEM-PL-ACC }.

tin    D * (^ DEF) = +
           @DET-FEM-SG-ACC.

to    D * (^ DEF) = +
          { @DET-NEUT-SG-NOM
          | @DET-NEUT-SG-ACC }.

ta    D * (^ DEF) = +
          { @DET-NEUT-PL-NOM
          | @DET-NEUT-PL-ACC }."

enas  D * (^ DEF) = -
          @DET-MASC-SG-NOM.

mja  D * (^ DEF) = -
         { @DET-FEM-SG-NOM
         | @DET-FEM-SG-ACC }.

ena  D * (^ DEF) = -
         { @DET-NEUT-SG-NOM
         | @DET-NEUT-SG-ACC }.

enos  D * (^ DEF) = -
          { @DET-MASC-SG-GEN
          | @DET-NEUT-SG-GEN }.

mjas  D * (^ DEF) = -
           @DET-FEM-SG-GEN.

enan  D * (^ DEF) = -
          @DET-MASC-SG-ACC.

polli D * (^ DEF) = -
            @DET-MASC-PL-NOM.

pollon D * (^ DEF) = -
            @DET-MASC-PL-GEN.

pollus D * (^ DEF) = -
            @DET-MASC-PL-ACC.


"PREPOSITIONS - πρόθεση + άρθρο"

"se   P * { (^ PRED) = 'to<(^OBJ)>'
           (^ PTYPE) = sem
         | (^ PTYPE) = nosem
           (^ PFORM) = se }
           (^ PP-TYPE) = plain."

ston P * { (^ PRED) = 'on<(^OBJ)>'
           (^ PTYPE) = sem
         | (^ PRED) = 'to<(^OBJ)>'
           (^ PTYPE) = nosem }
           (^ OBJ GEND) =c masc
           (^ OBJ NUM) =c sg
           (^ OBJ CASE) =c acc.

stus P * { (^ PRED) = 'on<(^OBJ)>'
           (^ PTYPE) = sem
         | (^ PRED) = 'to<(^OBJ)>'
           (^ PTYPE) = nosem }
           (^ OBJ GEND) =c masc
           (^ OBJ NUM) =c pl
           (^ OBJ CASE) =c acc.

stin P * { (^ PRED) = 'on<(^OBJ)>'
           (^ PTYPE) = sem
         | (^ PRED) = 'to<(^OBJ)>'
           (^ PTYPE) = nosem }
           (^ OBJ GEND) =c fem
           (^ OBJ NUM) =c sg
           (^ OBJ CASE) =c acc.

stis P * { (^ PRED) = 'on<(^OBJ)>'
           (^ PTYPE) = sem
         | (^ PRED) = 'to<(^OBJ)>'
           (^ PTYPE) = nosem }
           (^ OBJ GEND) =c fem
           (^ OBJ NUM) =c pl
           (^ OBJ CASE) =c acc.

sto P * { (^ PRED) = 'on<(^OBJ)>'
           (^ PTYPE) = sem
         | (^ PRED) = 'to<(^OBJ)>'
           (^ PTYPE) = nosem }
           (^ OBJ GEND) =c neut
           (^ OBJ NUM) =c sg
           (^ OBJ CASE) =c acc.

sta P * { (^ PRED) = 'on<(^OBJ)>'
           (^ PTYPE) = sem
         | (^ PRED) = 'to<(^OBJ)>'
           (^ PTYPE) = nosem }
           (^ OBJ GEND) =c neut
           (^ OBJ NUM) =c pl
           (^ OBJ CASE) =c acc.

oti  OTI * (^ MOOD) = indicative.
"it means 'that' and it initializes a COMP"

prin	P * (^ PRED) = 'before<(^OBJ)>'
         (^ PTYPE) = sem
         (^ OBJ CASE) =c acc.


