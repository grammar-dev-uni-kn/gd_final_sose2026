DEMO   GREEK   CONFIG (1.0)
  ROOTCAT   ROOT.
  FILES  .
  LEXENTRIES   (DEMO GREEK).
  TEMPLATES (DEMO GREEK).
  RULES   (DEMO GREEK).
  GOVERNABLERELATIONS    SUBJ OBJ OBL OBJ2 OBL-TO COMP.
  SEMANTICFUNCTIONS    ADJUNCT STANDARD.
  NONDISTRIBUTIVES    NUM PERS.
  EPSILON   e.
  OPTIMALITYORDER NOGOOD.
  GENOPTIMALITYORDER NOGOOD.

----


DEMO   GREEK   RULES (1.0)

  ROOT --> { S
           | Simp }.

  S -->    ({ADV*: !$(^ ADJUNCT)
           | PP*: !$(^ ADJUNCT) }) "Free word order - they can appear at the beginning of a clause"
           (NP: (^ TOPIC) = !
            (^ COMP* OBJ) = !
            { (! CASE) =c gen
            | (! CASE) =c acc })
         NP: (^ SUBJ) = !
           (! CASE) =c nom; "The subjects always has to be in Nominative case"
         VP: ^ = !
           (^ SUBJ PERS) = (^ VPERS)
           (^ SUBJ NUM) = (^ VNUM). "Subject-Verb agreement in person & number"

  
  Simp -->  ({ADV*: !$(^ ADJUNCT)
           | PP*: !$(^ ADJUNCT) })
            (NP: (^ TOPIC) = !
            (^ COMP* OBJ) = !
            { (! CASE) =c gen
            | (! CASE) =c acc })
            e: (^ SUBJ PRED) = 'pro'
               (^ SUBJ PERS) = (^ VPERS) "Pro-drop: null subject, licensed by verb agreement (person & number)"
               (^ SUBJ NUM) = (^ VNUM); 
            VP: ^ = !.

OTICOMP --> OTI: @MOOD-IND; "The COMP is inserted with the use of the word 'oti'. It is either an S or a Simp"
            { Simp: ^ = !
            | S: ^ = ! }.

VP --> (PRON: (^ OBJ2) = !
              (! PRON-TYPE) =c clitic
              (! CASE) =c gen)
       (PRON: (^ OBJ) = !
              (! PRON-TYPE) =c clitic
              (! CASE) =c acc)
        V: ^ = !;
       ({ NP: (^ OBJ) = ! (! CASE) =c acc;
         PP: (^ OBL-TO) = ! (! PTYPE) =c nosem
       | PP: (^ OBL-TO) = ! (! PTYPE) =c nosem;
         NP: (^ OBJ) = ! (! CASE) =c acc
       | NP: (^ OBJ) = ! (! CASE) =c acc
       | PP: (^ OBL-TO) = ! (! PTYPE) =c nosem } )
       (NP: (^ OBJ2) = ! (! CASE) =c gen)
       ({ ADV: !$(^ADJUNCT)
        | PP: !$(^ADJUNCT) (! PTYPE) =c sem } )*
       (OTICOMP: (^ COMP) = !).


  NP --> (D: ^ = !)
         (AP*: !$(^ ADJUNCT)
         (! GEND) =c (^ GEND)
             (! NUM)  =c (^ NUM)
             (! CASE) =c (^ CASE))
          N: ^ = !.

  PP --> P: ^ = !;
         (D: ^ = !)
         NP: (^ OBJ) = !.

  AP --> (ADV: ! $ (^ ADJUNCT))
          A
         (COMMA).


----

DEMO   GREEK   TEMPLATES (1.0)


"Verb mood"

MOOD-IND = (^ MOOD) = indicative.


"Verb tense"

PRESENT = (^ TENSE) = pres.
PAST = (^ TENSE) = past.


"Verb aspect"

ASPECT-PERF = (^ ASPECT) = perfective.
ASPECT-IMPERF = (^ ASPECT) = imperfective.


"Agreement: stores agreement on the verb for pro-drop licensing"
AGR(P N) = (^ VPERS) = P
           (^ VNUM)  = N.


"Verb voice"

VOICE-ACT = (^ VOICE) = active.
VOICE-PASS = (^ VOICE) = passive.


"Verb arguments - with examples in english for better understanding"

INTRANS(P) = (^ PRED) = 'P<(^ SUBJ)>'. "e.g. I run"

TRANS(P) = (^ PRED) = 'P<(^ SUBJ)(^ OBJ)>'. "e.g. I love chocolate"

OPT-TRANS(P) = { @(INTRANS P) | @(TRANS P) }. "e.g. I eat / I eat food"

DITRANS(P) = { (^ PRED)='P<(^ SUBJ)(^ OBJ)(^ OBL-TO)>' "e.g. I gave flowers to Mary"
                | (^ PRED)='P<(^ SUBJ)(^ OBJ)(^ OBJ2)>' }.  "e.g. I gave Mary flowers"

GEN-COMP(P) = (^ PRED) = 'P<(^ SUBJ)(^ OBJ2)(^ COMP)>'. "e.g. I told you that I love you"

OBJ-COMP(P) = (^ PRED) = 'P<(^ SUBJ)(^ OBJ)(^ COMP)>'. "e.g. I informed him that dinner is ready"

COMP-ONLY(P) = (^ PRED) = 'P<(^ SUBJ)(^ COMP)>'. "e.g. I said that I love chocolate"

GOAL(P) = (^ PRED) = 'P<(^ SUBJ)(^ OBL-TO)>'. "e.g. I go to the cinema"


"Gender"

NOUN-MASC = (^ GEND) = masc.

NOUN-FEM  = (^ GEND) = fem.

NOUN-NEUT = (^ GEND) = neut.


"NOUNS: Number and Case"

NOUN-NOM-SG = (^ NUM) = sg
              (^ CASE) = nom
              (^ PERS) = 3.

NOUN-NOM-PL = (^ NUM) = pl
              (^ CASE) = nom
              (^ PERS) = 3.

NOUN-GEN-SG = (^ NUM) = sg
              (^ CASE) = gen
              (^ PERS) = 3.

NOUN-GEN-PL = (^ NUM) = pl
              (^ CASE) = gen
              (^ PERS) = 3.

NOUN-ACC-SG = (^ NUM) = sg
              (^ CASE) = acc
              (^ PERS) = 3.

NOUN-ACC-PL = (^ NUM) = pl
              (^ CASE) = acc
              (^ PERS) = 3.

NOUN-VOC-SG = (^ NUM) = sg
              (^ CASE) = voc
              (^ PERS) = 3.

NOUN-VOC-PL = (^ NUM) = pl
              (^ CASE) = voc
              (^ PERS) = 3.


"Determiner agreement"

DET-MASC-SG-NOM = (^ GEND) =c masc
                 (^ NUM)  =c sg
                 (^ CASE) =c nom
                 (^ PERS) = 3.

DET-MASC-PL-NOM = (^ GEND) =c masc
                 (^ NUM)  =c pl
                 (^ CASE) =c nom
                 (^ PERS) = 3.

DET-MASC-SG-GEN = (^ GEND) =c masc
                 (^ NUM)  =c sg
                 (^ CASE) =c gen
                 (^ PERS) = 3.

DET-MASC-PL-GEN = (^ GEND) =c masc
                 (^ NUM)  =c pl
                 (^ CASE) =c gen
                 (^ PERS) = 3.

DET-MASC-SG-ACC = (^ GEND) =c masc
                 (^ NUM)  =c sg
                 (^ CASE) =c acc
                 (^ PERS) = 3.

DET-MASC-PL-ACC = (^ GEND) =c masc
                 (^ NUM)  =c pl
                 (^ CASE) =c acc
                 (^ PERS) = 3.

DET-FEM-SG-NOM = (^ GEND) =c fem
                 (^ NUM)  =c sg
                 (^ CASE) =c nom
                 (^ PERS) = 3.

DET-FEM-PL-NOM = (^ GEND) =c fem
                 (^ NUM)  =c pl
                 (^ CASE) =c nom
                 (^ PERS) = 3.

DET-FEM-SG-GEN = (^ GEND) =c fem
                 (^ NUM)  =c sg
                 (^ CASE) =c gen
                 (^ PERS) = 3.

DET-FEM-PL-GEN = (^ GEND) =c fem
                 (^ NUM)  =c pl
                 (^ CASE) =c gen
                 (^ PERS) = 3.

DET-FEM-SG-ACC = (^ GEND) =c fem
                 (^ NUM)  =c sg
                 (^ CASE) =c acc
                 (^ PERS) = 3.

DET-FEM-PL-ACC = (^ GEND) =c fem
                 (^ NUM)  =c pl
                 (^ CASE) =c acc
                 (^ PERS) = 3.

DET-NEUT-SG-NOM = (^ GEND) =c neut
                 (^ NUM)  =c sg
                 (^ CASE) =c nom
                 (^ PERS) = 3.

DET-NEUT-PL-NOM = (^ GEND) =c neut
                 (^ NUM)  =c pl
                 (^ CASE) =c nom
                 (^ PERS) = 3.

DET-NEUT-SG-GEN = (^ GEND) =c neut
                 (^ NUM)  =c sg
                 (^ CASE) =c gen
                 (^ PERS) = 3.

DET-NEUT-PL-GEN = (^ GEND) =c neut
                 (^ NUM)  =c pl
                 (^ CASE) =c gen
                 (^ PERS) = 3.

DET-NEUT-SG-ACC = (^ GEND) =c neut
                 (^ NUM)  =c sg
                 (^ CASE) =c acc
                 (^ PERS) = 3.

DET-NEUT-PL-ACC = (^ GEND) =c neut
                 (^ NUM)  =c pl
                 (^ CASE) =c acc
                 (^ PERS) = 3.


"Adjectives - Noun agreement"

ADJ-AGR(G N C) = (^ GEND) = G
                 (^ NUM)  = N
                 (^ CASE) = C.


"Pronoun agreement"

PRON-AGR(P N C) = (^ PERS) = P
                  (^ NUM) = N
                  (^ CASE) = C.



