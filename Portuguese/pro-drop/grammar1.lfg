DEMO ENGLISH LEXICON (1.0)


"adjectives"

estúpido	A * (^ PRED) = 'estúpido'
		    (^ GEND) = masc
                    (^ NUM) = sg.

feio		A * (^ PRED) = 'feio'
		    (^ GEND) = masc
                    (^ NUM) = sg.

bonito		A * (^ PRED) = 'bonito'
		    (^ GEND) = masc
                    (^ NUM) = sg.

simpaticas	A * (^ PRED) = 'simpaticas'
		    (^ GEND) = fem
                    (^ NUM) = pl.


"complementizers"

que	  C * (^ COMP-FORM) = que.


"determiners"

a	D *  (^ DEF) = +
             (^ GEND) = fem
             (^ NUM) = sg.


"prepositions"

com	P * @(PREP com).

para	P * @(PREP para).

no	P * @(PREP no).			"agglutinated form (prep em + art o)"

"proper nouns"

Ana	 N * @(PN Ana) @FNF.

João	 N * @(PN João) @FNM.

Mario	 N * @(PN Mario) @FNM.

Paulo	 N * @(PN Paulo) @FNM.


"pronouns"

eu	PRON * (^ PRED) = 'eu'
               (^ PERS) = 1
               (^ NUM) = sg
               (^ GEND) = -
	       (^ CASE) =  nom
               (^ PRON-TYPE) = pers.


o	PRON * (^ PRED) = 'o'
		 (^ NUM) = sg
		 (^ PERS) = 3
		 (^ CASE) = acc
		 (^ PRON-TYPE) = pers
      		 (^ NTYPE) = pron.


ele	PRON * (^ PRED) = 'ele'
               (^ PERS) = 3
               (^ NUM) = sg 
               (^ GEND) = masc
	       (^ CASE) =  nom
               (^ PRON-TYPE) = pers.

elas	PRON * (^ PRED) = 'elas'
               (^ PERS) = 3
               (^ NUM) = pl 
               (^ GEND) = fem
	       (^ CASE) =  nom
               (^ PRON-TYPE) = pers.


ninguém		PRON *   (^ PRED) = 'ninguém'
		 	 (^ NUM) = sg
		  	 (^ PERS) = 3
		 	 (^ PRON-TYPE) = indef
      		 	 (^ NTYPE) = pron.


"verbs"

acha		V *  (^ PRED) = 'dizer<(^ SUBJ)(^ COMP)>'
                     (^ PERS) = 3
                     (^ NUM) = sg
                     (^ TNS-ASP) = pres
                     (^ MOOD) = ind.

é		V *  (^ PRED) = 'ser<(^ SUBJ)(^ PREDICATE)>'
                     (^ PERS) = 3
                     (^ NUM) = sg
               	     (^ TNS-ASP) = pres
                     (^ MOOD) = ind.

são		V *  (^ PRED) = 'ser<(^ SUBJ)(^ PREDICATE)>'
                     (^ PERS) = 3
                     (^ NUM) = pl
               	     (^ TNS-ASP) = pres
                     (^ MOOD) = ind.

falei		V * {(^ PRED) = 'falar'
	  	    |(^ PRED) = 'falar<(^ SUBJ)>'}
	    	     (^ NUM) = sg
	             (^ PERS) = 1
	             (^ TNS-ASP) = past
                     (^ MOOD) = ind.

comprei		V *  (^ PRED) = 'comprar<(^ SUBJ)(^ OBJ)>'
                     (^ PERS) = 1
                     (^ NUM) = sg
               	     (^ TNS-ASP) = past
                     (^ MOOD) = ind.


comprou		V *  (^ PRED) = 'comprar<(^ SUBJ)(^ OBJ)>'
                     (^ PERS) = 3
                     (^ NUM) = sg
               	     (^ TNS-ASP) = past
                     (^ MOOD) = ind.

levou		V * (^ PRED) = 'levar<(^ SUBJ)(^ OBJ)>'
	    	     (^ NUM) = sg
	   	     (^ PERS) = 3
	    	     (^ TNS-ASP) = past
            	     (^ MOOD) = ind.

disse	V *  (^ PRED) = 'dizer<(^ SUBJ)(^ COMP)>'
             (^ PERS) = 3
             (^ NUM) = sg
             (^ TNS-ASP) = past
             (^ MOOD) = ind.

vai		V *  (^ PRED) = 'ir<(^ SUBJ)(^ OBJ)>'
                     (^ PERS) = 3
                     (^ NUM) = sg
                     (^ TNS-ASP) = pres
                     (^ MOOD) = ind.

vamos		V *  (^ PRED) = 'ir<(^ SUBJ)>'
                     (^ PERS) = 1
                     (^ NUM) = pl
                     (^ TNS-ASP) = pres
                     (^ MOOD) = ind.

"nouns"

casa	N * (^ PRED) = 'casa'
            (^ GEND) = fem
            (^ NUM) = sg
            (^ ANIM) = -.

mãe	N * (^ PRED) = 'mãe'
            (^ GEND) = fem
            (^ NUM) = sg
            (^ ANIM) = +.

mercado	N * (^ PRED) = 'mercado'
            (^ GEND) = masc
            (^ NUM) = sg
            (^ ANIM) = -.

pão	N * (^ PRED) = 'pão'
            (^ GEND) = masc
            (^ NUM) = sg
            (^ ANIM) = -.


"coordination"

e	CONJ * (^ COORD-FORM) = e.


"punctuation"

? INTER * .

